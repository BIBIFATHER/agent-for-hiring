# HH application credentials from https://dev.hh.ru
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://127.0.0.1:8765/callback

# User-Agent is required by HH API etiquette. Use a real contact.
HH_USER_AGENT=hh-auto-apply/0.1 anton@example.com

# Comma-separated HH vacancy search filters.
# Area: 1 = Moscow, 113 = Russia. Text uses HH search syntax.
HH_SEARCH_TEXT=коммерческий директор OR head of sales OR CCO OR директор по продажам OR директор по развитию бизнеса
HH_SEARCH_AREA=
HH_SEARCH_SCHEDULE=
HH_SEARCH_EMPLOYMENT=
HH_SEARCH_EXPERIENCE=
HH_SEARCH_PERIOD=7
HH_SEARCH_PER_PAGE=50
HH_SEARCH_PAGES=10

# Resume selection. If empty, the CLI shows available resumes.
HH_RESUME_ID=

# Optional cover letter. Required if vacancy.response_letter_required=true.
HH_COVER_LETTER=

# Safety limits.
HH_DRY_RUN=true
HH_MAX_APPLICATIONS_PER_RUN=50
HH_REQUEST_DELAY_SECONDS=2.0
HH_SKIP_IF_LETTER_REQUIRED=true
HH_SKIP_IF_NO_RESPONSE_URL=true

# Browser fallback while HH API app is under moderation.
HH_BROWSER_PROFILE_DIR=data/browser-profile
HH_BROWSER_HEADLESS=false
HH_BROWSER_SEARCH_URL=
HH_SEARCH_PROFILES_FILE=search_profiles_hh_recommended.json
HH_COVER_LETTER_RULES_FILE=cover_letter_rules.json

# Optional AI personalization. Keep disabled until OPENAI_API_KEY is set.
HH_LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
HH_LLM_TIMEOUT_SECONDS=6.0

# Local storage.
HH_TOKEN_FILE=data/tokens.json
HH_DB_FILE=data/hh_auto_apply.sqlite3
